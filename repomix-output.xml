  Built-in themes — full, hand-tuned token sets (not run through the
  theme-engine derivation, so they can be pixel-picked for best contrast).
  Custom themes (user-created) are generated by shared/theme-engine.js and
  stored separately in config.json.
*/
(function (root) {
  const BUILTIN_THEMES = {
    nebula: {
      id: "nebula",
      name: "Material You",
      builtin: true,
      tokens: {
        "--md-primary": "#d0bcff",
