<file path="control/control.css">
html, body { margin: 0; height: 100%; background: var(--md-surface-dim); color: var(--md-on-surface); font-family: var(--font-body); overflow: hidden; }

#app { display: flex; flex-direction: column; height: 100vh; }

/* ---------- Top bar ---------- */
.topbar {
  flex-shrink: 0;
  height: 56px;
  display: flex;
  align-items: center;
  padding: 0 16px;
  gap: 24px;
  background: var(--md-surface-container-low);
  border-bottom: 1px solid var(--md-outline-variant);
  -webkit-app-region: drag;
}
.topbar button, .topbar input { -webkit-app-region: no-drag; }
.topbar__brand { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-size: 15px; font-weight: 600; letter-spacing: 0.2px; }
.topbar__brand b { color: var(--md-primary); }
.topbar__brand-mark { width: 22px; height: 22px; border-radius: 50%; background: linear-gradient(135deg, var(--md-secondary), var(--md-primary), var(--md-tertiary)); flex-shrink: 0; }
.topbar__tabs { display: flex; gap: 2px; background: var(--md-surface-container); padding: 4px; border-radius: var(--shape-full); }
.topbar__tab { border: none; background: transparent; color: var(--md-on-surface-variant); font-family: var(--font-body); font-size: 13px; font-weight: 500; padding: 7px 18px; border-radius: var(--shape-full); cursor: pointer; -webkit-app-region: no-drag; }
.topbar__tab:hover { color: var(--md-on-surface); }
.topbar__tab.is-active { background: var(--md-primary); color: var(--md-on-primary); }
.topbar__status { margin-left: auto; display: flex; gap: 8px; }

/* ---------- Views ---------- */
.view { flex: 1; display: flex; overflow: hidden; }
.view[hidden] { display: none; }

/* ---------- Library rail ---------- */
.library { width: 216px; flex-shrink: 0; border-right: 1px solid var(--md-outline-variant); background: var(--md-surface-container-low); padding: 16px 12px; display: flex; flex-direction: column; gap: 10px; overflow-y: auto; }
.library__title { font-family: var(--font-display); font-size: 11px; text-transform: uppercase; letter-spacing: 0.6px; color: var(--md-on-surface-variant); padding: 0 4px; }
.library__list { display: flex; flex-direction: column; gap: 8px; }
.library-card { display: flex; align-items: center; gap: 10px; padding: 10px; border-radius: var(--shape-md); background: var(--md-surface-container); border: 1px solid var(--md-outline-variant); cursor: grab; transition: background 150ms var(--easing-standard), border-color 150ms, transform 150ms; }
.library-card:hover { background: var(--md-surface-container-high); border-color: var(--md-primary); transform: translateY(-1px); }
.library-card:active { cursor: grabbing; }
.library-card__icon { width: 32px; height: 32px; border-radius: var(--shape-sm); background: var(--md-primary-container); color: var(--md-on-primary-container); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.library-card__icon svg { width: 18px; height: 18px; }
.library-card__text { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.library-card__label { font-size: 13px; font-weight: 600; color: var(--md-on-surface); }
.library-card__desc { font-size: 10.5px; color: var(--md-on-surface-variant); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.library__hint { font-size: 11px; color: var(--md-on-surface-variant); opacity: 0.75; padding: 4px; line-height: 1.4; margin-top: auto; }

/* ---------- Canvas ---------- */
.canvas-area { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.canvas-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: auto;
  padding: 24px;
  background: repeating-conic-gradient(var(--md-surface-container-lowest) 0% 25%, var(--md-surface-dim) 0% 50%) 50% / 24px 24px;
}
.canvas-wrap.is-drop-target { outline: 2px dashed var(--md-primary); outline-offset: -8px; }
.canvas { position: relative; width: 960px; height: 540px; background: rgba(0, 0, 0, 0.15); border-radius: var(--shape-sm); box-shadow: 0 0 0 1px var(--md-outline-variant), var(--elev-3); overflow: hidden; flex-shrink: 0; }
.canvas-toolbar { flex-shrink: 0; display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-top: 1px solid var(--md-outline-variant); background: var(--md-surface-container-low); }
.canvas-toolbar__url { font-family: var(--font-mono); font-size: 12px; color: var(--md-on-surface-variant); background: var(--md-surface-container-highest); padding: 7px 10px; border-radius: var(--shape-sm); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.canvas-widget { position: absolute; cursor: grab; outline: 1px dashed transparent; border-radius: var(--shape-sm); }
.canvas-widget:hover { outline-color: rgba(198, 184, 255, 0.45); }
.canvas-widget.is-selected { outline: 2px solid var(--md-primary); outline-offset: 1px; }
.canvas-widget.is-dragging { cursor: grabbing; opacity: 0.92; }
.canvas-widget__content { width: 100%; height: 100%; pointer-events: none; container-type: inline-size; }
.canvas-widget__label {
  position: absolute; top: -20px; left: 0; font-size: 10px; font-family: var(--font-mono); color: var(--md-primary);
  background: var(--md-surface-dim); padding: 1px 6px; border-radius: 4px; opacity: 0; transition: opacity 120ms; white-space: nowrap; pointer-events: none;
}
.canvas-widget:hover .canvas-widget__label, .canvas-widget.is-selected .canvas-widget__label { opacity: 1; }

.resize-handle { position: absolute; width: 10px; height: 10px; background: var(--md-primary); border: 2px solid var(--md-surface-dim); border-radius: 3px; display: none; }
.canvas-widget.is-selected .resize-handle { display: block; }
.resize-handle[data-h="nw"] { top: -5px; left: -5px; cursor: nwse-resize; }
.resize-handle[data-h="ne"] { top: -5px; right: -5px; cursor: nesw-resize; }
.resize-handle[data-h="sw"] { bottom: -5px; left: -5px; cursor: nesw-resize; }
.resize-handle[data-h="se"] { bottom: -5px; right: -5px; cursor: nwse-resize; }

/* ---------- Inspector (layers + properties) ---------- */
.inspector { width: 272px; flex-shrink: 0; border-left: 1px solid var(--md-outline-variant); background: var(--md-surface-container-low); display: flex; flex-direction: column; overflow-y: auto; }
.inspector__section { padding: 14px; border-bottom: 1px solid var(--md-outline-variant); }
.inspector__title { font-family: var(--font-display); font-size: 11px; text-transform: uppercase; letter-spacing: 0.6px; color: var(--md-on-surface-variant); margin-bottom: 10px; }

.layers { display: flex; flex-direction: column; gap: 3px; }
.layer-row { display: flex; align-items: center; gap: 8px; padding: 7px 8px; border-radius: var(--shape-sm); cursor: pointer; font-size: 13px; }
.layer-row:hover { background: var(--md-surface-container); }
.layer-row.is-selected { background: var(--md-primary-container); color: var(--md-on-primary-container); }
.layer-row__icon { width: 20px; height: 20px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: var(--md-on-surface-variant); }
.layer-row.is-selected .layer-row__icon { color: var(--md-on-primary-container); }
.layer-row__icon svg { width: 14px; height: 14px; }
.layer-row__label { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.layer-row__btns { display: flex; gap: 2px; }
.layer-row__btn { background: none; border: none; color: inherit; opacity: 0.65; cursor: pointer; display: flex; padding: 3px; border-radius: 4px; }
.layer-row__btn:hover { opacity: 1; background: rgba(255, 255, 255, 0.1); }
.layer-row__btn svg { width: 13px; height: 13px; }
.layers__empty { font-size: 12px; color: var(--md-on-surface-variant); opacity: 0.7; padding: 4px; }

.properties { display: flex; flex-direction: column; gap: 12px; }
.properties__row { display: flex; gap: 8px; }
.properties__row .md-field { flex: 1; }
.properties__toggle-row { display: flex; align-items: center; justify-content: space-between; }
.properties__toggle-row label { font-size: 13px; color: var(--md-on-surface); }
.properties__test-grid { display: flex; flex-wrap: wrap; gap: 6px; }
.properties__test-grid .md-button { flex: 1 1 auto; font-size: 12px; padding: 8px 10px; }
.properties__hint { font-size: 11px; color: var(--md-on-surface-variant); line-height: 1.4; }
.properties__delete { display: flex; justify-content: flex-end; margin-top: 2px; }
.properties__delete .md-button { padding: 6px 10px; font-size: 12px; color: var(--md-error); }
.properties__delete .md-button svg { width: 14px; height: 14px; }

/* ---------- Settings ---------- */
.settings { padding: clamp(1rem, 2.5vw, 2rem); overflow-y: auto; display: flex; flex-direction: column; gap: clamp(0.75rem, 1.5vw, 1.25rem); max-width: min(720px, 100%); margin: 0 auto; width: 100%; }
.settings__card { padding: clamp(1rem, 2vw, 1.5rem); display: flex; flex-direction: column; gap: clamp(0.6rem, 1vw, 0.8rem); }
.settings__card h2 { margin: 0; font-family: var(--font-display); font-size: 16px; font-weight: 600; }
.settings__desc { margin: 0; font-size: 13px; color: var(--md-on-surface-variant); line-height: 1.5; }
.settings__hint { font-size: 12px; color: var(--md-on-surface-variant); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; background: var(--md-surface-container-highest); padding: 8px 10px; border-radius: var(--shape-sm); }
.settings__hint code { font-family: var(--font-mono); color: var(--md-on-surface); }
.settings__actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }
.settings__statuses { display: flex; gap: 8px; margin-top: 2px; }

.icon-btn svg { width: 16px; height: 16px; }

/* ---------- Canvas grid ---------- */
.canvas-toolbar__grid {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--md-on-surface-variant);
  flex-shrink: 0;
}
.canvas-toolbar__grid select {
  font-family: var(--font-body);
  font-size: 12px;
  color: var(--md-on-surface);
  background: var(--md-surface-container-highest);
  border: 1px solid var(--md-outline-variant);
  border-radius: var(--shape-sm);
  padding: 6px 8px;
}
.canvas.show-grid {
  background-image:
    linear-gradient(90deg, rgba(198, 184, 255, 0.14) 1px, transparent 1px),
    linear-gradient(180deg, rgba(198, 184, 255, 0.14) 1px, transparent 1px);
  background-size: var(--grid-x, 48px) var(--grid-y, 27px);
}

/* ---------- Theme picker ---------- */
.theme-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 10px;
}
.theme-swatch {
  border: 1px solid var(--md-outline-variant);
  border-radius: var(--shape-md);
  padding: 10px;
  cursor: pointer;
  background: var(--md-surface-container);
  transition: border-color 150ms, background 150ms;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.theme-swatch:hover { border-color: var(--md-primary); }
.theme-swatch.is-active { border-color: var(--md-primary); background: var(--md-primary-container); }
.theme-swatch__dots { display: flex; gap: 5px; }
.theme-swatch__dot { width: 16px; height: 16px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.25); }
.theme-swatch__name { font-size: 12.5px; font-weight: 600; color: var(--md-on-surface); }
.theme-swatch.is-active .theme-swatch__name { color: var(--md-on-primary-container); }
.theme-swatch__row { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
.theme-swatch__btn { background: none; border: none; color: inherit; opacity: 0.7; cursor: pointer; padding: 2px; border-radius: 4px; display: flex; }
.theme-swatch__btn:hover { opacity: 1; background: rgba(255, 255, 255, 0.12); }
.theme-swatch__btn svg { width: 13px; height: 13px; }

.theme-editor {
  margin-top: 14px;
  padding: 16px;
  border: 1px solid var(--md-outline-variant);
  border-radius: var(--shape-md);
  background: var(--md-surface-container);
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.theme-editor__colors { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
.theme-editor__color { display: flex; flex-direction: column; gap: 4px; align-items: center; }
.theme-editor__color label { font-size: 11px; color: var(--md-on-surface-variant); }
.theme-editor__color input[type="color"] {
  width: 44px; height: 32px; border-radius: var(--shape-sm); border: 1px solid var(--md-outline-variant);
  background: none; padding: 0; cursor: pointer;
}
.theme-editor__row { display: flex; gap: 10px; }
.theme-editor__row .md-field { flex: 1; }
.theme-editor select {
  font-family: var(--font-body); font-size: 13px; color: var(--md-on-surface); background: var(--md-surface-container-highest);
  border: 1px solid var(--md-outline-variant); border-radius: var(--shape-sm); padding: 9px 10px; width: 100%;
}

/* ---------- Scenes preview ---------- */
.scenes-preview-wrap { padding: 24px; }
.scenes-preview-scale {
  width: 960px;
  height: 540px;
  overflow: hidden;
  border-radius: var(--shape-sm);
  box-shadow: 0 0 0 1px var(--md-outline-variant), var(--elev-3);
  position: relative;
  flex-shrink: 0;
}
.scenes-preview-frame {
  width: 1920px;
  height: 1080px;
  border: none;
  display: block;
  transform: scale(0.5);
  transform-origin: top left;
}

.scene-socials-list { display: flex; flex-direction: column; gap: 8px; }
.scene-social-row { display: flex; gap: 6px; align-items: center; }
.scene-social-row input[type="text"] {
  font-family: var(--font-body); font-size: 13px; color: var(--md-on-surface); background: var(--md-surface-container-highest);
  border: 1px solid var(--md-outline-variant); border-radius: var(--shape-sm); padding: 7px 9px;
}
.scene-social-row input.platform { width: 56px; text-align: center; text-transform: uppercase; }
.scene-social-row input.text { flex: 1; min-width: 0; }
.scene-social-row .layer-row__btn { flex-shrink: 0; }

.library-card.is-active { border-color: var(--md-primary); background: var(--md-primary-container); }
.library-card.is-active .library-card__label,
.library-card.is-active .library-card__desc { color: var(--md-on-primary-container); }

.topbar__chat-btn { margin-left: 10px; font-size: 12px; padding: 7px 14px; }
.topbar__chat-btn svg { width: 14px; height: 14px; }

/* ---------- Events history ---------- */
.events-history {
  display: flex;
  flex-direction: column;
  gap: 6px;
  max-height: 320px;
  overflow-y: auto;
}
.events-history__empty {
  font-size: 12px;
  color: var(--md-on-surface-variant);
  opacity: 0.7;
  padding: 6px 2px;
}
.events-history__row {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  padding: 7px 8px;
  border-radius: var(--shape-sm);
  background: var(--md-surface-container);
  border: 1px solid var(--md-outline-variant);
  font-size: 12.5px;
}
.events-history__type {
  font-weight: 700;
  padding: 1px 6px;
  border-radius: 4px;
  background: var(--md-tertiary-container);
  color: var(--md-on-tertiary-container);
  font-size: 11px;
}
.events-history__type--donation { background: var(--md-secondary-container); color: var(--md-on-secondary-container); }
.events-history__type--subscription { background: var(--md-primary-container); color: var(--md-on-primary-container); }
.events-history__type--follow { background: var(--md-tertiary-container); color: var(--md-on-tertiary-container); }
.events-history__user { font-weight: 600; color: var(--md-on-surface); }
.events-history__amount { color: var(--md-primary); font-weight: 600; }
.events-history__message { color: var(--md-on-surface-variant); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.events-history__time { margin-left: auto; font-family: var(--font-mono); font-size: 11px; color: var(--md-on-surface-variant); opacity: 0.75; }
.events-history__test {
  font-size: 10px;
  padding: 1px 5px;
  border-radius: 4px;
  background: var(--md-error-container);
  color: var(--md-on-error-container);
}
.events-history__replay {
  padding: 3px 8px;
  font-size: 11px;
  flex-shrink: 0;
}

/* ---------- Giveaway / Fortune Wheel ---------- */
.giveaway-participants {
  display: flex;
  flex-direction: column;
  gap: 6px;
  max-height: 240px;
  overflow-y: auto;
}
.giveaway-manual {
  display: flex;
  gap: 8px;
  align-items: center;
}
.giveaway-manual input {
  flex: 1;
  font-family: var(--font-body);
  font-size: 0.95rem;
  color: var(--md-on-surface);
  background: var(--md-surface-container-highest);
  border: 1px solid var(--md-outline-variant);
  border-radius: var(--shape-sm);
  padding: 0.6rem 0.8rem;
  outline: none;
}
.giveaway-manual input:focus { border-color: var(--md-primary); }
.giveaway-participant-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding: 0.4rem 0.6rem;
  border-radius: var(--shape-sm);
  background: var(--md-surface-container);
  border: 1px solid var(--md-outline-variant);
  font-size: 0.875rem;
}
.giveaway-participant__name { color: var(--md-on-surface); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.giveaway-participant__remove {
  background: none;
  border: none;
  color: var(--md-error);
  cursor: pointer;
  font-size: 13px;
  padding: 2px 6px;
  border-radius: 4px;
  opacity: 0.75;
}
.giveaway-participant__remove:hover { opacity: 1; background: rgba(255, 180, 171, 0.14); }

/* ---------- Participants widget settings ---------- */
.settings__row { display: flex; gap: 12px; }
.settings__row .md-field { flex: 1; }
.md-field input[type="range"] { width: 100%; padding: 0; }
.md-field input[type="color"] { height: 40px; padding: 2px; }
.inspector__quick-btn { width: 100%; justify-content: center; }

/* ---------- Responsive ---------- */
@media (max-width: 1200px) {
  .settings__actions { gap: 0.5rem; }
  .events-history__row { font-size: 12px; }
}
@media (max-width: 920px) {
  .settings__actions { flex-direction: column; align-items: stretch; }
  .giveaway-manual { flex-direction: column; align-items: stretch; }
  .giveaway-participants { max-height: 200px; }
  .events-history__replay { padding: 0.4rem 0.6rem; }
}
</file>

<file path="control/control.html">
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <title>Open Stream Environment — панель управления</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&family=Roboto+Mono:wght@500;700&family=Rajdhani:wght@500;600;700&family=Orbitron:wght@500;700;900&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="../shared/theme.css" />
  <link rel="stylesheet" href="../shared/widgets.css" />
  <link rel="stylesheet" href="control.css" />
</head>
<body>
  <div id="app">
    <header class="topbar">
      <div class="topbar__brand">
        <span class="topbar__brand-mark"></span>
        <span class="topbar__brand-name">Open Stream <b>Environment</b></span>
      </div>
      <nav class="topbar__tabs" id="tabs">
        <button class="topbar__tab is-active" data-view="editor">Редактор</button>
        <button class="topbar__tab" data-view="scenes">Сцены</button>
        <button class="topbar__tab" data-view="wheel">Колесо Фортуны</button>
        <button class="topbar__tab" data-view="settings">Настройки</button>
      </nav>
      <div class="topbar__status" id="statusChips"></div>
      <button class="md-button md-button--tonal topbar__chat-btn" id="openChatWindowBtn"></button>
    </header>

    <section class="view" id="view-editor">
      <aside class="library" id="library">
        <div class="library__title">Виджеты</div>
        <div class="library__list" id="libraryList"></div>
        <div class="library__hint">Перетащите на канвас или нажмите, чтобы добавить</div>
      </aside>

      <div class="canvas-area">
        <div class="canvas-wrap" id="canvasWrap">
          <div class="canvas" id="canvas"></div>
        </div>
        <div class="canvas-toolbar">
          <div class="canvas-toolbar__url" id="obsUrlLabel">http://localhost:8710/overlay/overlay.html</div>
          <button class="md-button md-button--tonal" id="copyUrlBtn"></button>
          <label class="canvas-toolbar__grid">
            Сетка
            <select id="gridSizeSelect">
              <option value="0">Выкл</option>
              <option value="2">2%</option>
              <option value="5">5%</option>
              <option value="10">10%</option>
            </select>
          </label>
        </div>
      </div>

      <aside class="inspector">
        <div class="inspector__section">
          <div class="inspector__title">Слои</div>
          <div class="layers" id="layers"></div>
        </div>
        <div class="inspector__section" id="propertiesSection" hidden>
          <div class="inspector__title" id="propertiesTitle">Свойства</div>
          <div class="properties" id="properties"></div>
        </div>
        <div class="inspector__section">
          <div class="inspector__title">Быстрый доступ</div>
          <button class="md-button md-button--tonal inspector__quick-btn" id="openWheelSettingsBtn">Колесо Фортуны</button>
        </div>
      </aside>
    </section>

    <section class="view" id="view-scenes" hidden>
      <aside class="library" id="scenesNav">
        <div class="library__title">Сцены</div>
        <div class="library__list" id="scenesNavList"></div>
        <div class="library__hint">Каждая сцена — отдельный источник в OBS, показывается вместо игры целиком (не поверх).</div>
      </aside>

      <div class="canvas-area">
        <div class="canvas-wrap scenes-preview-wrap">
          <div class="scenes-preview-scale">
            <iframe class="scenes-preview-frame" id="scenesPreviewFrame" title="Превью сцены"></iframe>
          </div>
        </div>
        <div class="canvas-toolbar">
          <div class="canvas-toolbar__url" id="sceneUrlLabel"></div>
          <button class="md-button md-button--tonal" id="copySceneUrlBtn"></button>
        </div>
      </div>

      <aside class="inspector">
        <div class="inspector__section" id="sceneFormSection">
          <div class="inspector__title" id="sceneFormTitle">Свойства сцены</div>
          <div class="properties" id="sceneForm"></div>
        </div>
      </aside>
    </section>

    <section class="view" id="view-wheel" hidden>
      <div class="settings">
        <div class="settings__card md-card">
          <h2>Колесо Фортуны</h2>
          <p class="settings__desc">Розыгрыш среди зрителей чата. Зрители пишут команду, чтобы попасть в список участников.</p>
          <div class="md-field">
            <label>Команда для участия</label>
            <input type="text" id="giveawayCommand" placeholder="!go" />
          </div>
          <div class="settings__statuses">
            <span class="md-chip" id="giveawayChip"><span class="md-chip__dot"></span><span id="giveawayCount">Участников: 0</span></span>
          </div>
          <div class="settings__actions">
            <button class="md-button md-button--filled" id="startGiveawayBtn">Начать сбор</button>
            <button class="md-button md-button--outlined" id="stopGiveawayBtn">Остановить</button>
            <button class="md-button md-button--tonal" id="shuffleGiveawayBtn">Перемешать</button>
            <button class="md-button md-button--tonal" id="generateWheelBtn">Сгенерировать колесо</button>
            <button class="md-button md-button--filled" id="spinWheelBtn">Крутить колесо</button>
          </div>
          <div class="properties__toggle-row">
            <label>Режим на выбывание</label>
            <div class="md-switch" id="giveawayElimination"><div class="md-switch__thumb"></div></div>
          </div>
          <div class="md-field">
            <label>Громкость музыки колеса: <span id="wheelMusicVolumeValue">50%</span></label>
            <input type="range" id="wheelMusicVolume" min="0" max="100" step="1" />
          </div>
          <div class="md-field">
            <label>Скорость вращения: <span id="wheelSpeedValue">3</span></label>
            <input type="range" id="wheelSpeed" min="1" max="5" step="1" />
          </div>
          <div class="giveaway-manual">
            <input type="text" id="giveawayManualName" placeholder="Никнейм зрителя" />
            <button class="md-button md-button--tonal" id="addParticipantBtn">Добавить</button>
          </div>
          <div class="giveaway-participants" id="giveawayParticipants"></div>
        </div>
      </div>
    </section>

    <section class="view" id="view-settings" hidden>
      <div class="settings">
        <div class="settings__card md-card">
          <h2>Twitch</h2>
          <p class="settings__desc">
            Чат подключается анонимно и не требует токена. Для алертов о фоллоу/сабах/чирах нужно
            зарегистрировать приложение и авторизоваться.
          </p>
          <div class="md-field">
            <label>Канал</label>
            <input type="text" id="twitchChannel" placeholder="halantar" />
          </div>
          <div class="md-field">
            <label>Client ID</label>
            <input type="text" id="twitchClientId" placeholder="из dev.twitch.tv/console/apps" />
          </div>
          <div class="md-field">
            <label>Client Secret</label>
            <input type="password" id="twitchClientSecret" placeholder="••••••••" />
          </div>
          <div class="settings__hint">
            <span>Redirect URI для приложения:</span>
            <code id="twitchRedirectUri"></code>
            <button class="md-button md-button--text" data-copy="twitchRedirectUri"></button>
          </div>
          <div class="settings__actions">
            <button class="md-button md-button--text" id="openTwitchConsole">Открыть dev.twitch.tv/console/apps</button>
            <button class="md-button md-button--filled" id="connectTwitchBtn">Подключить Twitch</button>
          </div>
          <div class="settings__statuses">
            <span class="md-chip" id="chip-twitchChat"><span class="md-chip__dot"></span><span class="md-chip__label">Чат</span></span>
            <span class="md-chip" id="chip-twitchEvents"><span class="md-chip__dot"></span><span class="md-chip__label">Алерты</span></span>
          </div>
        </div>

        <div class="settings__card md-card">
          <h2>DonationAlerts</h2>
          <p class="settings__desc">Донаты автоматически увеличивают счётчик цели и запускают алерт.</p>
          <div class="md-field">
            <label>Client ID</label>
            <input type="text" id="daClientId" placeholder="из donationalerts.com/application/clients" />
          </div>
          <div class="md-field">
            <label>Client Secret</label>
            <input type="password" id="daClientSecret" placeholder="••••••••" />
          </div>
          <div class="settings__hint">
            <span>Redirect URI для приложения:</span>
            <code id="daRedirectUri"></code>
            <button class="md-button md-button--text" data-copy="daRedirectUri"></button>
          </div>
          <div class="settings__actions">
            <button class="md-button md-button--text" id="openDaConsole">Открыть donationalerts.com/application/clients</button>
            <button class="md-button md-button--filled" id="connectDaBtn">Подключить DonationAlerts</button>
          </div>
          <div class="settings__statuses">
            <span class="md-chip" id="chip-donationAlerts"><span class="md-chip__dot"></span><span class="md-chip__label">DonationAlerts</span></span>
          </div>
        </div>

        <div class="settings__card md-card">
          <h2>Приложение</h2>
          <div class="md-field">
            <label>Порт локального сервера</label>
            <input type="text" id="appPort" disabled />
            <span class="md-field__hint">Чтобы изменить — отредактируйте config/config.json и перезапустите приложение.</span>
          </div>
          <div class="md-field">
            <label>URL оверлея для OBS Browser Source</label>
            <input type="text" id="appOverlayUrl" disabled />
          </div>
          <div class="settings__actions">
            <button class="md-button md-button--outlined" id="resetLayoutBtn">Сбросить раскладку по умолчанию</button>
          </div>
        </div>

        <div class="settings__card md-card">
          <h2>История событий</h2>
          <p class="settings__desc">Последние донаты, подписки и фолловы. Кнопка «Повторить» запускает анимацию в оверлее.</p>
          <div class="events-history" id="eventsHistory"></div>
          <div class="settings__actions">
            <button class="md-button md-button--tonal" id="refreshEventsBtn">Обновить</button>
            <button class="md-button md-button--outlined" id="loadMoreEventsBtn" hidden>Показать ещё</button>
          </div>
        </div>

        <div class="settings__card md-card">
          <h2>Оформление</h2>
          <p class="settings__desc">Тема влияет только на сам оверлей (и его превью на канвасе) — панель управления всегда выглядит одинаково.</p>
          <div class="theme-grid" id="themeGrid"></div>
          <div class="settings__actions">
            <button class="md-button md-button--outlined" id="newThemeBtn">Создать свою тему</button>
          </div>
          <div class="theme-editor" id="themeEditor" hidden></div>
        </div>

        <div class="settings__card md-card">
          <h2>Экспорт / импорт настроек</h2>
          <p class="settings__desc">
            Экспорт сохраняет полный config.json — раскладку, темы, цель, а также токены и ключи Twitch/DonationAlerts.
            Файл содержит секреты — не выкладывайте его публично.
          </p>
          <div class="settings__actions">
            <button class="md-button md-button--tonal" id="exportConfigBtn"></button>
            <button class="md-button md-button--outlined" id="importConfigBtn"></button>
          </div>
          <div class="settings__hint" id="exportImportStatus" hidden></div>
        </div>
      </div>
    </section>
  </div>

  <script src="../shared/events.js"></script>
  <script src="../shared/icons.js"></script>
  <script src="../shared/widget-catalog.js"></script>
  <script src="../shared/theme-engine.js"></script>
  <script src="../shared/themes.js"></script>
  <script src="../shared/scenes-catalog.js"></script>
  <script src="control.js"></script>
</body>
</html>
</file>

