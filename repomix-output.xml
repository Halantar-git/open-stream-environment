.splash-card {
  background: var(--surface-color);
  padding: 40px;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 50px var(--accent-glow);
  width: 480px;
  position: relative;
}

.splash-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 16px;
  background-image: linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  background-size: 20px 20px;
  pointer-events: none;
}

.header {
  margin-bottom: 30px;
  position: relative;
  z-index: 1;
}

.brand-name {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.brand-name span {
  color: var(--accent-color);
}

.subtitle {
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 4px;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.console-log {
  background: rgba(0, 0, 0, 0.3);
  padding: 15px;
  border-radius: 8px;
  font-size: 12px;
  height: 100px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.02);
  margin-bottom: 25px;
  position: relative;
  z-index: 1;
}

.log-line {
  color: var(--text-muted);
  margin-bottom: 6px;
  white-space: nowrap;
  animation: typeIn 0.2s ease-out forwards;
}

.log-line.success { color: var(--md-secondary); }
.log-line.active { color: var(--text-primary); }

@keyframes typeIn {
  from { opacity: 0; transform: translateY(3px); }
  to { opacity: 1; transform: translateY(0); }
}

.progress-container {
  width: 100%;
  height: 4px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 2px;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.progress-bar {
  height: 100%;
  width: 0%;
  background: var(--accent-color);
  box-shadow: 0 0 10px var(--accent-color);
  animation: loadProgress 3.5s cubic-bezier(0.2, 0, 0, 1) forwards;
}

@keyframes loadProgress {
  0% { width: 0%; }
  20% { width: 15%; }
  50% { width: 65%; }
  80% { width: 90%; }
  100% { width: 100%; }
}
