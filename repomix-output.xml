html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  background: transparent;
  overflow: hidden;
  font-family: var(--font-body);
}

#canvas {
  position: relative;
  width: 100vw;
  height: 100vh;
}

/* ---- Alert entrance / exit (the signature moment) ---- */
.widget-alert {
  opacity: 0;
  transform: scale(0.86);
  filter: blur(6px);
}
.widget-alert.alert-enter-active {
  animation: alert-in var(--alert-enter-duration, 480ms) var(--alert-enter-easing, var(--easing-emphasized-decelerate)) forwards;
}
.widget-alert.alert-exit {
  animation: alert-out 260ms var(--easing-emphasized-accelerate) forwards;
}

@keyframes alert-in {
  0% { opacity: 0; transform: scale(0.86); filter: blur(6px); }
  60% { opacity: 1; filter: blur(0); }
  100% { opacity: 1; transform: scale(1); filter: blur(0); }
}
@keyframes alert-out {
  0% { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: scale(0.92); }
}

/* Nebula spark burst, fires once alongside the entrance. Six dots at
   different angles/delays/distances read as a small starburst without
   needing a canvas or particle library. */
.widget-alert.alert-enter-active .widget-alert__spark span {
  animation: spark-fly 700ms var(--easing-emphasized-decelerate) forwards;
}
.widget-alert__spark span:nth-child(1) { --angle: -18deg; --dist: 70px; animation-delay: 60ms; }
.widget-alert__spark span:nth-child(2) { --angle: 12deg; --dist: 90px; animation-delay: 110ms; }
.widget-alert__spark span:nth-child(3) { --angle: 42deg; --dist: 60px; animation-delay: 40ms; }
.widget-alert__spark span:nth-child(4) { --angle: -48deg; --dist: 55px; animation-delay: 140ms; }
.widget-alert__spark span:nth-child(5) { --angle: 75deg; --dist: 40px; animation-delay: 90ms; }
.widget-alert__spark span:nth-child(6) { --angle: -78deg; --dist: 45px; animation-delay: 170ms; }

@keyframes spark-fly {
  0% { opacity: 0; transform: rotate(var(--angle)) translateX(0) scale(0.6); }
  35% { opacity: 1; }
  100% {
    opacity: 0;
    transform: rotate(var(--angle)) translateX(var(--dist)) scale(1);
  }
}

/* ---- Chat message fade-in ---- */
.widget-chat__msg {
  animation: chat-in 220ms var(--easing-standard) both;
}
@keyframes chat-in {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ---- Recent-events row fade-in ---- */
.widget-recent__item {
  animation: recent-in 260ms var(--easing-standard) both;
}
@keyframes recent-in {
  from { opacity: 0; transform: translateX(-6px); }
  to { opacity: 1; transform: translateX(0); }
}

/* ---------- Fortune Wheel (pseudo-3D) ---------- */
.wheel {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%) scale(var(--wheel-scale, 1));
  z-index: 1000;
  width: 640px;
  height: 640px;
  pointer-events: none;
}
.wheel[hidden] { display: none; }

.wheel__stage {
  position: relative;
  width: 100%;
  height: 100%;
  perspective: 1400px;
  transform-style: preserve-3d;
}

.wheel__barrel {
  position: absolute;
  inset: 0;
  transform-style: preserve-3d;
  transform: rotateX(30deg);
  border-radius: 50%;
  background: radial-gradient(circle at 50% 40%, rgba(255, 255, 255, 0.22), rgba(0, 0, 0, 0.28) 68%);
  box-shadow:
    0 46px 80px rgba(0, 0, 0, 0.55),
    inset 0 0 0 12px rgba(255, 255, 255, 0.06),
    inset 0 0 36px rgba(0, 0, 0, 0.35);
}
.wheel__barrel::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 32%, rgba(255, 255, 255, 0.30), rgba(255, 255, 255, 0) 40%),
    radial-gradient(circle at 50% 100%, rgba(0, 0, 0, 0.38), rgba(0, 0, 0, 0) 62%);
  pointer-events: none;
  z-index: 2;
}

#wheelCanvas {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 50%;
  filter: drop-shadow(0 28px 44px rgba(0, 0, 0, 0.5));
}

.wheel__hub {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 104px;
  height: 104px;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, var(--md-primary-container), var(--md-primary) 72%);
  border: 6px solid var(--md-on-primary);
  box-shadow: 0 0 26px var(--md-primary), inset 0 4px 12px rgba(255, 255, 255, 0.35);
  z-index: 3;
}

.wheel__marker {
  position: absolute;
  left: 50%;
  top: -10px;
  width: 0;
  height: 0;
  transform-origin: 50% 100%;
  transform: translateX(-50%) rotateX(24deg);
  border-left: 22px solid transparent;
  border-right: 22px solid transparent;
  border-top: 46px solid var(--md-primary);
  filter:
    drop-shadow(0 0 14px var(--md-primary))
    drop-shadow(0 8px 12px rgba(0, 0, 0, 0.65));
  z-index: 4;
}

.wheel__shadow {
  position: absolute;
  left: 50%;
  bottom: -72px;
  width: 72%;
  height: 64px;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0) 70%);
  filter: blur(10px);
}

.wheel.is-spinning .wheel__marker {
  animation: wheel-marker-tick 160ms linear infinite;
}

@keyframes wheel-marker-tick {
  0%, 100% { transform: translateX(-50%) rotateX(24deg) rotateZ(-5deg); }
  50% { transform: translateX(-50%) rotateX(24deg) rotateZ(5deg); }
}

/* ---------- Wheel scene participants panel ---------- */
.wheel-participants {
  position: fixed;
  left: 24px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 900;
  width: min(340px, 26vw);
  max-height: 70vh;
  overflow-y: auto;
  padding: 16px 18px;
  border-radius: var(--panel-radius);
  background: color-mix(in srgb, var(--md-surface-container) var(--pw-bg-opacity, 82%), transparent);
  backdrop-filter: blur(var(--panel-blur));
  -webkit-backdrop-filter: blur(var(--panel-blur));
  border: var(--panel-border);
  box-shadow: var(--elev-3);
  font-family: var(--font-body);
  font-size: var(--pw-font-size, 16px);
  color: var(--pw-text, var(--md-on-surface));
}
.wheel-participants[hidden] { display: none; }

/* ---------- Wheel scene winner result ---------- */
.wheel-result {
  position: fixed;
  left: 50%;
  top: 16%;
  transform: translateX(-50%);
  z-index: 1100;
  padding: 18px 30px;
  border-radius: var(--shape-xl);
  background: var(--panel-bg);
  backdrop-filter: blur(var(--panel-blur));
  -webkit-backdrop-filter: blur(var(--panel-blur));
  border: var(--panel-border);
  box-shadow: var(--panel-glow), var(--elev-3);
  color: var(--md-on-surface);
  font-family: var(--font-display);
  font-size: 30px;
  font-weight: 700;
  text-align: center;
  max-width: 80%;
  pointer-events: none;
}
.wheel-result[hidden] { display: none; }
.wheel-result.is-showing { animation: wheel-result-in 600ms var(--easing-emphasized-decelerate) forwards; }
@keyframes wheel-result-in {
  0% { opacity: 0; transform: translateX(-50%) scale(0.7); filter: blur(8px); }
  60% { opacity: 1; filter: blur(0); }
  100% { opacity: 1; transform: translateX(-50%) scale(1); }
}
