<file path="shared/widgets.css">
/*
  Visual styles for the four widget types. Loaded by both overlay.html
  (real data, live animation) and control.html (static sample data inside
  the editor canvas), so the editor preview always matches OBS exactly.
  Positioning (x/y/w/h) is applied inline per-instance by JS, not here.
*/

.widget-surface {
  width: 100%;
  height: 100%;
}

/* ---------- Alert card (the signature element) ---------- */
.widget-alert {
  --accent: var(--md-primary);
  --accent-on-container: var(--md-on-primary-container);
  --accent-container: var(--md-primary-container);
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 28px 16px 16px;
  background: var(--panel-bg, var(--md-surface-container-high));
  backdrop-filter: blur(var(--panel-blur, 0px));
  -webkit-backdrop-filter: blur(var(--panel-blur, 0px));
  border: var(--panel-border, 1px solid var(--md-outline-variant));
  border-radius: var(--panel-radius);
  clip-path: var(--panel-clip, none);
  box-shadow: var(--elev-3), var(--panel-glow, 0 0 0 rgba(0, 0, 0, 0));
  position: relative;
}
.widget-alert[data-kind="sub"],
.widget-alert[data-kind="gift_sub"] {
  --accent: var(--md-secondary);
  --accent-on-container: var(--md-on-secondary-container);
  --accent-container: var(--md-secondary-container);
}
.widget-alert[data-kind="cheer"],
.widget-alert[data-kind="donation"] {
  --accent: var(--md-tertiary);
  --accent-on-container: var(--md-on-tertiary-container);
  --accent-container: var(--md-tertiary-container);
}
.widget-alert[data-kind="wheel_start"] {
  --accent: var(--md-secondary);
  --accent-on-container: var(--md-on-secondary-container);
  --accent-container: var(--md-secondary-container);
}
.widget-alert[data-kind="wheel_winner"] {
  --accent: var(--md-tertiary);
  --accent-on-container: var(--md-on-tertiary-container);
  --accent-container: var(--md-tertiary-container);
  box-shadow: var(--elev-3), 0 0 40px var(--md-tertiary);
}
.widget-alert[data-kind="wheel_start"] .widget-alert__icon {
  animation: wheel-icon-spin 1s linear infinite;
}
@keyframes wheel-icon-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.widget-alert__icon {
  width: 25%;
  aspect-ratio: 1;
  min-width: 44px;
  max-width: 64px;
  border-radius: 50%;
  background: var(--accent-container);
  color: var(--accent-on-container);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.widget-alert__icon svg { width: 55%; height: 55%; }
.widget-alert__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.widget-alert__status { display: flex; align-items: center; gap: 6px; align-self: flex-start; }
.widget-alert__dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 6px var(--accent);
  flex-shrink: 0;
  animation: widget-alert-dot-blink 1.5s infinite;
}
@keyframes widget-alert-dot-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}
.widget-alert__kicker {
  display: inline-block;
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  color: var(--accent-on-container);
  background: var(--accent-container);
  padding: 3px 10px;
  border-radius: var(--shape-full);
}
.widget-alert__name {
  font-family: var(--font-display);
  font-size: clamp(15px, 6cqw, 24px);
  font-weight: 600;
  color: var(--md-on-surface);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.widget-alert__amount {
  font-family: var(--font-mono);
  font-size: clamp(13px, 4.5cqw, 18px);
  font-weight: 700;
  color: var(--accent);
}
.widget-alert__message {
  font-family: var(--font-body);
  font-style: italic;
  font-size: clamp(11px, 3.4cqw, 14px);
  color: var(--md-on-surface-variant);
  margin-top: 4px;
  max-width: 34ch;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  border-left: 3px solid var(--accent);
  background: rgba(0, 0, 0, 0.15);
  padding: 5px 10px;
  border-radius: 0 var(--shape-xs) var(--shape-xs) 0;
}
.widget-alert__lockbar { display: none; }
[data-decoration="brackets2"] .widget-alert__lockbar,
[data-decoration="brackets4"] .widget-alert__lockbar {
  display: block;
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 3px;
  background: rgba(255, 255, 255, 0.1);
  overflow: hidden;
}
[data-decoration="brackets2"] .widget-alert__lockbar-fill,
[data-decoration="brackets4"] .widget-alert__lockbar-fill {
  width: 100%;
  height: 100%;
  background: var(--accent);
  box-shadow: 0 0 8px var(--accent);
  animation: widget-alert-lock-pulse 1.5s infinite linear;
}
@keyframes widget-alert-lock-pulse {
  0% { opacity: 0.4; }
  50% { opacity: 1; }
  100% { opacity: 0.4; }
}
.widget-alert__spark { position: absolute; inset: 0; pointer-events: none; overflow: visible; }
.widget-alert__spark span {
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent);
  top: 50%;
  left: 18%;
  opacity: 0;
}

/* ---------- Donation goal ---------- */
.widget-goal {
  width: 100%;
  height: 100%;
  background: var(--panel-bg, var(--md-surface-container));
  backdrop-filter: blur(var(--panel-blur, 0px));
  -webkit-backdrop-filter: blur(var(--panel-blur, 0px));
  border: var(--panel-border, 1px solid var(--md-outline-variant));
  border-radius: var(--panel-radius);
  clip-path: var(--panel-clip, none);
  box-shadow: var(--elev-2), var(--panel-glow, 0 0 0 rgba(0, 0, 0, 0));
  padding: 12px 18px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8px;
}
.widget-goal__row { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
.widget-goal__title {
  font-family: var(--font-display);
  font-size: clamp(11px, 3.4cqw, 15px);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  color: var(--md-on-surface);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.widget-goal__amounts {
  font-family: var(--font-mono);
  font-size: clamp(11px, 3.2cqw, 14px);
  color: var(--md-on-surface-variant);
  white-space: nowrap;
}
.widget-goal__amounts b { color: var(--md-primary); font-weight: 700; }
.widget-goal__percent { align-self: flex-end; font-family: var(--font-mono); font-size: 11px; color: var(--md-secondary); }

/* ---------- Chat ---------- */
.widget-chat {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 6px;
  overflow: hidden;
}
.widget-chat__msg {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 6px;
  background: rgba(9, 7, 15, 0.58);
  border-radius: var(--panel-radius);
  padding: 6px 10px;
  font-family: var(--font-body);
  font-size: clamp(12px, 3cqw, 14px);
  line-height: 1.3;
  color: var(--md-on-surface);
}
.widget-chat__badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 15px;
  height: 15px;
  border-radius: 4px;
  background: var(--md-tertiary-container);
  color: var(--md-on-tertiary-container);
  font-size: 9px;
  font-weight: 700;
  flex-shrink: 0;
}
.widget-chat__badge[data-role="moderator"],
.widget-chat__badge[data-role="broadcaster"] {
  background: var(--md-error-container);
  color: var(--md-on-error-container);
}
.widget-chat__badge[data-role="vip"] {
  background: var(--md-tertiary-container);
  color: var(--md-on-tertiary-container);
}
.widget-chat__badge[data-role="subscriber"] {
  background: var(--md-secondary-container);
  color: var(--md-on-secondary-container);
}
.widget-chat__user { font-weight: 700; }
.widget-chat__colon { color: var(--md-on-surface-variant); }
.widget-chat__text { color: var(--md-on-surface); word-break: break-word; }

.twitch-emote {
  height: 1.4em;
  max-height: 28px;
  vertical-align: middle;
  margin: 0 1px;
}

/* ---------- Recent events ---------- */
.widget-recent {
  width: 100%;
  height: 100%;
  background: var(--panel-bg, var(--md-surface-container-low));
  backdrop-filter: blur(var(--panel-blur, 0px));
  -webkit-backdrop-filter: blur(var(--panel-blur, 0px));
  border: var(--panel-border, 1px solid var(--md-outline-variant));
  border-radius: var(--panel-radius);
  clip-path: var(--panel-clip, none);
  box-shadow: var(--elev-1), var(--panel-glow, 0 0 0 rgba(0, 0, 0, 0));
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  overflow: hidden;
}
.widget-recent__title {
  font-family: var(--font-display);
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  color: var(--md-on-surface-variant);
  flex-shrink: 0;
}
.widget-recent__list { display: flex; flex-direction: column; gap: 6px; overflow: hidden; }
.widget-recent__item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-body);
  font-size: clamp(11px, 3cqw, 13px);
  color: var(--md-on-surface);
}
.widget-recent__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--md-primary); flex-shrink: 0; }
.widget-recent__dot[data-kind="sub"],
.widget-recent__dot[data-kind="gift_sub"] { background: var(--md-secondary); }
.widget-recent__dot[data-kind="cheer"],
.widget-recent__dot[data-kind="donation"] { background: var(--md-tertiary); }
.widget-recent__item b { font-weight: 700; }
.widget-recent__empty { font-size: 12px; color: var(--md-on-surface-variant); opacity: 0.7; }

/* ---------- Positioned instance wrapper (shared by overlay + editor) ---------- */
.widget-instance {
  position: absolute;
  container-type: inline-size;
  container-name: widget;
}
.widget-alerts-host {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

/* ---------- Custom widget (text / image / raw HTML, user-authored) ---------- */
.widget-custom {
  width: 100%;
  height: 100%;
  overflow: hidden;
}
.widget-custom.has-card {
  background: var(--panel-bg, var(--md-surface-container));
  backdrop-filter: blur(var(--panel-blur, 0px));
  -webkit-backdrop-filter: blur(var(--panel-blur, 0px));
  border: var(--panel-border, 1px solid var(--md-outline-variant));
  border-radius: var(--panel-radius);
  clip-path: var(--panel-clip, none);
  box-shadow: var(--elev-2), var(--panel-glow, 0 0 0 rgba(0, 0, 0, 0));
}
.widget-custom__text {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4px;
  padding: 14px 18px;
  color: var(--md-on-surface);
  font-family: var(--font-body);
}
.widget-custom__text[data-align="left"] { align-items: flex-start; text-align: left; }
.widget-custom__text[data-align="center"] { align-items: center; text-align: center; }
.widget-custom__text[data-align="right"] { align-items: flex-end; text-align: right; }
.widget-custom__title {
  font-family: var(--font-display);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  font-size: clamp(11px, 3.4cqw, 15px);
  color: var(--md-on-surface-variant);
}
.widget-custom__body[data-size="small"] { font-size: clamp(11px, 3cqw, 14px); }
.widget-custom__body[data-size="medium"] { font-size: clamp(14px, 5cqw, 22px); }
.widget-custom__body[data-size="large"] { font-size: clamp(18px, 8cqw, 34px); font-family: var(--font-display); font-weight: 600; }
.widget-custom__image {
  width: 100%;
  height: 100%;
  display: block;
}
.widget-custom__html {
  width: 100%;
  height: 100%;
  border: none;
  display: block;
}

/* ---------- HUD-style theme decoration ----------
   Toggled by JS via a `data-decoration` attribute on the overlay body or
   the editor's #canvas (values: none | brackets2 | brackets4) — driven by
   the active theme's --panel-decoration token, not a specific theme id,
   so custom "angular" themes get the same corner brackets and scanline
   texture as the built-in Star Citizen theme. */
[data-decoration="brackets2"] .widget-alert,
[data-decoration="brackets2"] .widget-goal,
[data-decoration="brackets2"] .widget-recent,
[data-decoration="brackets2"] .widget-custom.has-card,
[data-decoration="brackets4"] .widget-alert,
[data-decoration="brackets4"] .widget-goal,
[data-decoration="brackets4"] .widget-recent,
[data-decoration="brackets4"] .widget-custom.has-card {
  position: relative;
  background-image: repeating-linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.035) 0px,
    rgba(255, 255, 255, 0.035) 1px,
    transparent 1px,
    transparent 3px
  );
}

/* Two-corner brackets (Star Citizen and angular custom themes) */
[data-decoration="brackets2"] .widget-alert::before,
[data-decoration="brackets2"] .widget-goal::before,
[data-decoration="brackets2"] .widget-recent::before,
[data-decoration="brackets2"] .widget-custom.has-card::before,
[data-decoration="brackets2"] .widget-alert::after,
[data-decoration="brackets2"] .widget-goal::after,
[data-decoration="brackets2"] .widget-recent::after,
[data-decoration="brackets2"] .widget-custom.has-card::after {
  content: "";
  position: absolute;
  width: 16px;
  height: 16px;
  pointer-events: none;
  opacity: 0.9;
}
[data-decoration="brackets2"] .widget-alert::before,
[data-decoration="brackets2"] .widget-goal::before,
[data-decoration="brackets2"] .widget-recent::before,
[data-decoration="brackets2"] .widget-custom.has-card::before {
  top: -1px;
  left: -1px;
  border-top: 2px solid var(--md-primary);
  border-left: 2px solid var(--md-primary);
}
[data-decoration="brackets2"] .widget-alert::after,
[data-decoration="brackets2"] .widget-goal::after,
[data-decoration="brackets2"] .widget-recent::after,
[data-decoration="brackets2"] .widget-custom.has-card::after {
  bottom: -1px;
  right: -1px;
  border-bottom: 2px solid var(--md-primary);
  border-right: 2px solid var(--md-primary);
}

/* Four-corner brackets (Orbital) — a single ::before pseudo-element with
   8 layered solid-color gradients (2 short bars per corner) so all four
   corners are covered without needing extra DOM nodes. */
[data-decoration="brackets4"] .widget-alert::before,
[data-decoration="brackets4"] .widget-goal::before,
[data-decoration="brackets4"] .widget-recent::before,
[data-decoration="brackets4"] .widget-custom.has-card::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.9;
  background-image:
    linear-gradient(var(--md-primary), var(--md-primary)),
    linear-gradient(var(--md-primary), var(--md-primary)),
    linear-gradient(var(--md-primary), var(--md-primary)),
    linear-gradient(var(--md-primary), var(--md-primary)),
    linear-gradient(var(--md-primary), var(--md-primary)),
    linear-gradient(var(--md-primary), var(--md-primary)),
    linear-gradient(var(--md-primary), var(--md-primary)),
    linear-gradient(var(--md-primary), var(--md-primary));
  background-repeat: no-repeat;
  background-size: 14px 3px, 3px 14px, 14px 3px, 3px 14px, 14px 3px, 3px 14px, 14px 3px, 3px 14px;
  background-position:
    top -1px left -1px, top -1px left -1px,
    top -1px right -1px, top -1px right -1px,
    bottom -1px left -1px, bottom -1px left -1px,
    bottom -1px right -1px, bottom -1px right -1px;
}

/* ---------- Stat pill (followers / subscribers / top donation) ---------- */
.widget-stat {
  width: 100%;
  height: 100%;
  background: var(--panel-bg, var(--md-surface-container));
  backdrop-filter: blur(var(--panel-blur, 0px));
  -webkit-backdrop-filter: blur(var(--panel-blur, 0px));
  border: var(--panel-border, 1px solid var(--md-outline-variant));
  border-radius: var(--panel-radius);
  clip-path: var(--panel-clip, none);
  box-shadow: var(--elev-1), var(--panel-glow, 0 0 0 rgba(0, 0, 0, 0));
  padding: 8px 16px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.widget-stat__icon {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--md-primary-container);
  color: var(--md-on-primary-container);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.widget-stat__icon svg { width: 16px; height: 16px; }
.widget-stat__info { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.widget-stat__label {
  font-size: clamp(8px, 2.4cqw, 10px);
  color: var(--md-on-surface-variant);
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.widget-stat__value {
  font-family: var(--font-body);
  font-size: clamp(12px, 4cqw, 15px);
  color: var(--md-on-surface);
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- Rotating social banner ---------- */
.widget-social {
  width: 100%;
  height: 100%;
  background: var(--panel-bg, var(--md-surface-container));
  backdrop-filter: blur(var(--panel-blur, 0px));
  -webkit-backdrop-filter: blur(var(--panel-blur, 0px));
  border: var(--panel-border, 1px solid var(--md-outline-variant));
  border-radius: var(--panel-radius);
  clip-path: var(--panel-clip, none);
  box-shadow: var(--elev-1), var(--panel-glow, 0 0 0 rgba(0, 0, 0, 0));
  padding: 8px 16px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.widget-social__content {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  transition: opacity 300ms ease;
}
.widget-social__content.is-fading { opacity: 0; }
.widget-social__icon {
  background: var(--md-primary);
  color: var(--md-on-primary);
  font-weight: 900;
  font-size: clamp(9px, 2.6cqw, 11px);
  padding: 4px 8px;
  border-radius: var(--shape-sm);
  flex-shrink: 0;
}
.widget-social__info { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.widget-social__platform {
  font-size: clamp(8px, 2.2cqw, 9px);
  color: var(--md-on-surface-variant);
  font-weight: 700;
  letter-spacing: 0.5px;
}
.widget-social__handle {
  font-family: var(--font-body);
  font-size: clamp(11px, 3.4cqw, 14px);
  color: var(--md-on-surface);
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- Giveaway participants list ---------- */
.widget-participants {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 10px 12px;
  background: color-mix(in srgb, var(--md-surface-container) var(--pw-bg-opacity, 82%), transparent);
  backdrop-filter: blur(var(--panel-blur, 0px));
  -webkit-backdrop-filter: blur(var(--panel-blur, 0px));
  border: var(--panel-border, 1px solid var(--md-outline-variant));
  border-radius: var(--panel-radius);
  clip-path: var(--panel-clip, none);
  box-shadow: var(--elev-1), var(--panel-glow, 0 0 0 rgba(0, 0, 0, 0));
  overflow: hidden;
  font-family: var(--font-body);
  font-size: var(--pw-font-size, 16px);
  color: var(--pw-text, var(--md-on-surface));
}
.widget-participants__title {
  font-family: var(--font-display);
  font-size: 0.875em;
  font-weight: 700;
  color: var(--pw-text, var(--md-on-surface));
}
.widget-participants__list {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.375em;
  overflow-y: auto;
}
.widget-participants__chip {
  padding: 0.2em 0.5em;
  border-radius: var(--shape-full);
  background: var(--md-primary-container);
  color: var(--md-on-primary-container);
  font-size: 0.75em;
}
.widget-participants__more { font-size: 0.75em; color: var(--pw-text, var(--md-on-surface-variant)); }
.widget-participants__marquee {
  overflow: hidden;
  white-space: nowrap;
  width: 100%;
  display: flex;
}
.widget-participants__marquee span {
  display: inline-block;
  padding-left: 100%;
  animation: participants-marquee 18s linear infinite;
  white-space: nowrap;
}
@keyframes participants-marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-100%); }
}
</file>

<file path="splash/splash.css">
:root {
  --bg-color: var(--md-surface-dim);
  --surface-color: var(--md-surface-container);
  --accent-color: var(--md-primary);
  --accent-glow: color-mix(in srgb, var(--md-primary) 35%, transparent);
  --text-primary: var(--md-on-surface);
  --text-muted: var(--md-on-surface-variant);
  --font-main: var(--font-mono);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background-color: transparent;
  font-family: var(--font-main);
  color: var(--text-primary);
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  user-select: none;
}

.splash-card {
  background: var(--surface-color);
  padding: 40px;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 50px var(--accent-glow);
  width: 480px;
  position: relative;
}

.splash-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 16px;
  background-image: linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  background-size: 20px 20px;
  pointer-events: none;
}

.header {
  margin-bottom: 30px;
  position: relative;
  z-index: 1;
}

.brand-name {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.brand-name span {
  color: var(--accent-color);
}

.subtitle {
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 4px;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.console-log {
  background: rgba(0, 0, 0, 0.3);
  padding: 15px;
  border-radius: 8px;
  font-size: 12px;
  height: 100px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.02);
  margin-bottom: 25px;
  position: relative;
  z-index: 1;
}

.log-line {
  color: var(--text-muted);
  margin-bottom: 6px;
  white-space: nowrap;
  animation: typeIn 0.2s ease-out forwards;
}

.log-line.success { color: var(--md-secondary); }
.log-line.active { color: var(--text-primary); }

@keyframes typeIn {
  from { opacity: 0; transform: translateY(3px); }
  to { opacity: 1; transform: translateY(0); }
}

.progress-container {
  width: 100%;
  height: 4px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 2px;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.progress-bar {
  height: 100%;
  width: 0%;
  background: var(--accent-color);
  box-shadow: 0 0 10px var(--accent-color);
  animation: loadProgress 3.5s cubic-bezier(0.2, 0, 0, 1) forwards;
}

@keyframes loadProgress {
  0% { width: 0%; }
  20% { width: 15%; }
  50% { width: 65%; }
  80% { width: 90%; }
  100% { width: 100%; }
}
</file>

