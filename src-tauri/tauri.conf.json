{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Stream Environment",
  "version": "4.0.5",
  "identifier": "com.openstreamenvironment.app",
  "build": {
    "frontendDist": "../control"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "../assets/icons/32x32.png",
      "../assets/icons/128x128.png",
      "../assets/icons/icon.ico"
    ],
    "resources": {
      "../control": "control",
      "../overlay": "overlay",
      "../remote": "remote",
      "../chatwindow": "chatwindow",
      "../splash": "splash",
      "../widgeteditor": "widgeteditor",
      "../themeeditor": "themeeditor",
      "../csseditor": "csseditor",
      "../shared": "shared",
      "../assets": "assets",
      "../config/config.example.json": "config/config.example.json"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "../assets/icons/icon.ico",
        "displayLanguageSelector": true,
        "languages": [
          "Russian",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Halantar-git/open-stream-environment/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwOTQzNTBEQzk0QkU0MEUKUldRTzVFdkpEVFdVWUpBQ1pQQXhFQWRNbXZ2WE9BUkN1SGl6OUJ2UmgwelNpd2QrNTEvdHhSSEMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
